{
  "name": "zcontrol",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based remote control platform with WebRTC screen sharing.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\" --kill-others",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -ws",
    "lint": "npm run lint -w frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "multer": "^2.2.0"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zero-wyc/ZViewer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zero-wyc/ZViewer/issues"
  },
  "homepage": "https://github.com/Zero-wyc/ZViewer#readme"
}
