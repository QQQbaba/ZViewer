{
  "name": "zviewer",
  "version": "1.0.0",
  "private": true,
  "description": "ZViewer —— 基于浏览器的在线观影与屏幕共享平台。",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\" --kill-others",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -ws",
    "lint": "npm run lint -ws",
    "start": "node scripts/start.js",
    "build:exe": "node scripts/build-exe.js && node scripts/build-frontend-exe.js",
    "build:backend-exe": "node scripts/build-exe.js",
    "build:frontend-exe": "node scripts/build-frontend-exe.js"
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/build/Release/**/*.node",
      "node_modules/better-sqlite3/binding.gyp",
      "node_modules/.pnpm/**/better-sqlite3/build/Release/**/*.node",
      "backend/.env"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@yao-pkg/pkg": "^6.22.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "multer": "^2.2.0",
    "node-forge": "^1.4.0"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zero-wyc/ZViewer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zero-wyc/ZViewer/issues"
  },
  "homepage": "https://github.com/Zero-wyc/ZViewer#readme"
}
