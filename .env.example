# ========================
# 后端环境变量
# ========================

# 后端服务端口（宿主机映射）
PORT=3333

# 监听地址。:: 表示监听所有 IPv4/IPv6 地址（双栈）
HOST=::

# 运行环境：development / production
NODE_ENV=production

# SQLite 数据库文件路径（容器内）。
# 使用 Docker 时会被挂载到 named volume，重启后数据不丢失。
DATABASE_URL=/app/data/dev.sqlite

# CORS 允许来源
# 开发环境可设置为 *；生产环境建议设置为前端域名，如 https://your-domain.com
# 多个来源用逗号分隔，如 https://a.com,https://b.com
# 设置为 false 表示不允许跨域
CORS_ORIGIN=*

# JWT 密钥（生产环境必须设置为强随机字符串，请勿使用默认 dev secret）
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Token 过期时间
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# 前端构建参数
# ========================

# 前端 API / Socket.IO 基础地址。
# 生产环境建议留空，让前端使用 window.location.origin（配合 Nginx 反向代理）
# 本地开发时指向后端地址：http://localhost:3333
VITE_API_URL=

# OBS 推流模式 HTTP-FLV 拉流基础地址（可选）。
# 生产环境使用 HTTPS 时，建议通过 Nginx/Caddy 将 /live 反向代理到 NMS 的 HTTP-FLV 端口（默认 3335），
# 此时保持留空即可，前端会默认使用相对路径 /live。
# 若使用独立子域名（如 https://flv.example.com）或不同路径，请显式设置：
# VITE_FLV_BASE_URL=https://your-domain.com/live
VITE_FLV_BASE_URL=

# ========================
# OBS 推流服务端口
# ========================

# RTMP 推流端口（OBS 连接），默认 3334
# RTMP_PORT=3334

# HTTP-FLV 拉流端口（Node Media Server 内部使用），默认 3335
# 生产环境通常不需要直接暴露此端口，而是通过 Nginx 反向代理到 HTTPS 域名的 /live 路径
# HTTP_FLV_PORT=3335

# ========================
# PostgreSQL 配置（可选）
# ========================

# 如需使用 PostgreSQL，请同时修改后端 data-source.ts 中的数据库配置。
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=zcontrol
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://postgres:change_me@db:5432/zcontrol
